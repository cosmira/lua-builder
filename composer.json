{
    "name": "cosmira/lua-builder",
    "description": "Expressive, framework-independent Lua code generation for PHP.",
    "type": "library",
    "keywords": [
        "lua",
        "code-generation",
        "builder",
        "compiler",
        "php"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Alexandr Chernyaev",
            "email": "bliz48rus@gmail.com",
            "homepage": "https://tabuna.github.io",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "infection/infection": "^0.29.14 || ^0.32.4",
        "laravel/pint": "^1.27",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.5",
        "symfony/process": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Cosmira\\Lua\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cosmira\\Lua\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:coverage": [
            "@php -d pcov.enabled=1 -d pcov.directory=src vendor/bin/phpunit --coverage-clover build/clover.xml --coverage-html build/coverage --coverage-text",
            "@php tools/coverage.php"
        ],
        "test:mutation": "@php -d pcov.enabled=1 -d pcov.directory=src vendor/bin/infection --threads=4",
        "test:runtime": "@php vendor/bin/phpunit --testsuite Runtime",
        "lint": "@php vendor/bin/pint --test",
        "format": "@php vendor/bin/pint",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "refactor": "@php vendor/bin/rector process",
        "refactor:check": "@php vendor/bin/rector process --dry-run",
        "check": [
            "@composer validate --strict",
            "@lint",
            "@analyse",
            "@refactor:check",
            "@test:coverage",
            "@test:mutation"
        ]
    },
    "homepage": "https://github.com/cosmira/lua-builder",
    "support": {
        "issues": "https://github.com/cosmira/lua-builder/issues",
        "source": "https://github.com/cosmira/lua-builder"
    }
}
